{
  "name": "lms-backend-ts",
  "version": "1.0.0",
  "description": "LMS Backend API with TypeScript - Local and Lambda deployment",
  "main": "dist/lambda-deploy.js",
  "type": "module",
  "author": "Your Name",
  "license": "MIT",
  "keywords": [
    "lms",
    "typescript",
    "serverless",
    "aws",
    "lambda",
    "education"
  ],
  "scripts": {
    "dev": "tsx watch src/index-local.ts",
    "build": "tsc",
    "build:lambda": "tsc && cp package.json dist/",
    "start": "node dist/index-local.js",
    "start:lambda": "node dist/lambda-deploy.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.840.0",
    "@aws-sdk/lib-dynamodb": "^3.840.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "razorpay": "^2.9.6",
    "serverless-http": "^3.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^9.0.8",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
